# frpc 配置模板 —— 复制成 frpc.toml 并填入真实值（frpc.toml 已在 .gitignore，不入库）
#
# 跑在**本机**（GPU 机）上，连到你自己 VPS 上的 frps
# 作用：把本机 docker 网络里的 app-api:8000 透传到 VPS 的 8020 端口

serverAddr = "YOUR_SERVER_IP_OR_DOMAIN"   # VPS 公网 IP 或域名
serverPort = 7000

auth.method = "token"
auth.token = "CHANGE_ME_RANDOM_TOKEN"      # 与 VPS 上 frps.toml 一致

[[proxies]]
name = "mit-app"
type = "tcp"
localIP = "app-api"        # 同一个 compose 网络里，直接用服务名
localPort = 8000           # app-api 容器内端口
remotePort = 8020          # 在 VPS 上暴露的端口
